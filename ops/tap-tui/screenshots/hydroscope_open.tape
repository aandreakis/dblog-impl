Output "screenshots/.hydroscope_open.gif"

Set FontSize 18
Set Width 1400
Set Height 820
Set Padding 10
Set Theme "Blazer"
Set TypingSpeed 0ms

Hide
Type "./target/release/hydroscope --demo --slowdown 40"
Enter
Sleep 1000ms
Show
Screenshot "screenshots/4_hydroscope_open.png"
Sleep 200ms
Type "q"
Sleep 200ms
