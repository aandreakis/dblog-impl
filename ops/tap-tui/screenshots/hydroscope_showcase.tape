Output "screenshots/.hydroscope_showcase.gif"

Set FontSize 18
Set Width 1400
Set Height 820
Set Padding 10
Set Theme "Blazer"
Set TypingSpeed 0ms

Hide
Type "./target/release/hydroscope --scenario showcase --slowdown 60"
Enter
Sleep 5500ms
Show
Screenshot "screenshots/6_hydroscope_showcase.png"
Sleep 200ms
Type "q"
Sleep 200ms
