{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aandreakis/dblog-impl/blob/main/docs/schema/events/error-event.schema.json",
  "title": "ErrorEvent",
  "description": "A fail-closed runtime boundary was hit.",
  "type": "object",
  "properties": {
    "v":         { "description": "Tap schema version; always 1.", "type": "integer", "minimum": 1 },
    "seq":       { "description": "Monotonic per-run sequence number.", "type": "integer", "minimum": 0 },
    "ts":        { "description": "ISO-8601 UTC timestamp with microsecond resolution.", "type": "string", "format": "date-time" },
    "run_id":    { "description": "DBLog runtime run identifier.", "type": "string", "minLength": 1 },
    "source_id": { "description": "Configured dblog.source.id.", "type": "string", "minLength": 1 },
    "kind":      { "type": "string", "enum": ["error"] },
    "class":     { "description": "Exception class name, e.g. WatermarkSequenceException.", "type": "string" },
    "message":   { "type": "string" },
    "context":   { "description": "Structured detail.", "type": "object", "existingJavaType": "java.util.Map<String, Object>" }
  },
  "required": ["v", "ts", "run_id", "source_id", "kind", "class", "message"]
}
