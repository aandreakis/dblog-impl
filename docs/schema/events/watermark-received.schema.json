{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aandreakis/dblog-impl/blob/main/docs/schema/events/watermark-received.schema.json",
  "title": "WatermarkReceived",
  "description": "The reconciler observed the LOW or HIGH watermark token come back on the source change log.",
  "type": "object",
  "properties": {
    "v":          { "description": "Tap schema version; always 1.", "type": "integer", "minimum": 1 },
    "seq":        { "description": "Monotonic per-run sequence number.", "type": "integer", "minimum": 0 },
    "ts":         { "description": "ISO-8601 UTC timestamp with microsecond resolution.", "type": "string", "format": "date-time" },
    "run_id":     { "description": "DBLog runtime run identifier.", "type": "string", "minLength": 1 },
    "source_id":  { "description": "Configured dblog.source.id.", "type": "string", "minLength": 1 },
    "kind":       { "type": "string", "enum": ["watermark.received"] },
    "level":      { "type": "string", "enum": ["LOW", "HIGH"] },
    "token":      { "description": "Same token written earlier.", "type": "string" },
    "chunk_id":   { "type": "integer", "minimum": 0 },
    "lsn":        { "description": "LSN at which the watermark row was observed.", "type": "string" },
    "latency_ms": { "description": "Elapsed wall time from the matching watermark.written.", "type": "integer", "minimum": 0 }
  },
  "required": ["v", "ts", "run_id", "source_id", "kind", "level", "token", "chunk_id", "lsn"]
}
