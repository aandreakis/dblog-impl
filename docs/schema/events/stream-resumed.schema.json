{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aandreakis/dblog-impl/blob/main/docs/schema/events/stream-resumed.schema.json",
  "title": "StreamResumed",
  "description": "The producer is no longer blocked. Emitted out of band; seq is null.",
  "type": "object",
  "properties": {
    "v":                { "description": "Tap schema version; always 1.", "type": "integer", "minimum": 1 },
    "seq":              { "description": "Null on stream.resumed — the event is emitted out of band.", "type": "null" },
    "ts":               { "description": "ISO-8601 UTC timestamp with microsecond resolution.", "type": "string", "format": "date-time" },
    "run_id":           { "description": "DBLog runtime run identifier.", "type": "string", "minLength": 1 },
    "source_id":        { "description": "Configured dblog.source.id.", "type": "string", "minLength": 1 },
    "kind":             { "type": "string", "enum": ["stream.resumed"] },
    "standby_total_ms": { "type": "integer", "minimum": 0 }
  },
  "required": ["v", "ts", "run_id", "source_id", "kind", "standby_total_ms"]
}
